// federated-social Tailscale policy file
// ----------------------------------------------------------------------------
// Paste this into the Tailscale admin console under Access Controls.
//
// WARNING: pasting this REPLACES your existing policy in full. If you have
// an existing tailnet with custom rules, merge the relevant blocks below
// into your current policy rather than overwriting it. (Tailscale keeps
// version history if you do clobber it; revert via the version log.)
//
// This template uses the modern "grants" syntax. Legacy "acls" arrays are
// still supported by Tailscale indefinitely, but grants is the recommended
// shape for new policies. See:
// https://tailscale.com/docs/reference/grants-vs-acls
//
// ---------------------------------------------------------------------------
// The tag-owns-itself gotcha
// ---------------------------------------------------------------------------
// You will see each app tag listed as its own tagOwner, e.g.:
//
//     "tag:db-redis": ["autogroup:admin", "tag:db-redis"]
//
// This is NOT redundant. Tailscale's control plane rejects tag application
// from auth keys when the only owner is "autogroup:admin", even when the
// human who created the credential IS an admin. The workaround — adding the
// tag itself to its own owner list — is the documented pattern for
// auth-key-based node creation. Failing to include it produces this error
// at sidecar boot:
//
//     Received error: requested tags [tag:db-redis] are invalid or not permitted
//
// See https://github.com/tailscale/tailscale/issues/12402 for context.
//
// Note for the OAuth-client path: this self-ownership pattern alone is NOT
// sufficient for OAuth clients. The OAuth client *also* needs the right
// scopes — Devices+Core, Keys+AuthKeys, AND Keys+OAuthKeys (R+W on each),
// with the full tag list assigned. See the Tailscale section in
// .env.example for the exact configuration. Missing the AuthKeys or
// OAuthKeys scopes produces a different but equally confusing 403:
//
//     Status: 403, Message: "calling actor does not have enough permissions
//     to perform this function"

{
  "tagOwners": {
    // Shared infrastructure
    "tag:db-postgres":          ["autogroup:admin", "tag:db-postgres"],
    "tag:db-redis":             ["autogroup:admin", "tag:db-redis"],

    // Pixelfed
    "tag:pixelfed-web":         ["autogroup:admin", "tag:pixelfed-web"],
    "tag:pixelfed-worker":      ["autogroup:admin", "tag:pixelfed-worker"],

    // Mastodon
    "tag:mastodon-web":         ["autogroup:admin", "tag:mastodon-web"],
    "tag:mastodon-streaming":   ["autogroup:admin", "tag:mastodon-streaming"],
    "tag:mastodon-sidekiq":     ["autogroup:admin", "tag:mastodon-sidekiq"],

    // Diaspora (single embedded container — sidekiq runs in-process)
    "tag:diaspora-web":         ["autogroup:admin", "tag:diaspora-web"],

    // Host reverse proxy. Apply this tag to your Debian host machine in
    // the admin console (Machines -> ... -> Edit tags) so the grants
    // below let the host nginx reach the app web tiers over the tailnet.
    "tag:reverse-proxy":        ["autogroup:admin", "tag:reverse-proxy"],

    // Funkwhale
    "tag:funkwhale-web":         ["autogroup:admin", "tag:funkwhale-web"],
    "tag:funkwhale-worker":      ["autogroup:admin", "tag:funkwhale-worker"],

    // GoToSocial (single container — no separate worker tier)
    "tag:gotosocial-web":        ["autogroup:admin", "tag:gotosocial-web"],

    // PeerTube (single container; serves both HTTP and RTMP from one sidecar)
    "tag:peertube-web":          ["autogroup:admin", "tag:peertube-web"],

    // Garage — shared S3-compatible object storage
    "tag:garage":                ["autogroup:admin", "tag:garage"],

    // Stalwart mail server (SMTP, IMAP, JMAP/admin)
    "tag:stalwart":              ["autogroup:admin", "tag:stalwart"],

    // Authelia SSO / OIDC provider
    "tag:authelia":              ["autogroup:admin", "tag:authelia"],

    // Lemmy — federated link aggregator
    "tag:lemmy-web":             ["autogroup:admin", "tag:lemmy-web"],

    // Console — heart-of-gold operator dashboard / fleet observer
    "tag:console-web":           ["autogroup:admin", "tag:console-web"],

    // Optional: tag your streaming/broadcast machines so they can publish
    // RTMP to PeerTube without going through a public ingest proxy.
    // "tag:streamer":          ["autogroup:admin", "tag:streamer"],
  },

  "grants": [
    // App tiers reach shared Postgres on TCP/5432 only.
    // Add new app tags to this src list when you bring them up.
    // NOTE: in an HA deployment the app-facing endpoint (DB_MAGIC_NAME) is the
    // pg-router sidecar, which also carries tag:db-postgres — so this same
    // grant covers apps -> router. The router -> primary and standby ->
    // primary hops are the tag:db-postgres self-grant just below.
    {
      "src": [
        "tag:pixelfed-web", "tag:pixelfed-worker",
        "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
        "tag:diaspora-web",
        "tag:funkwhale-web", "tag:funkwhale-worker",
        "tag:gotosocial-web",
        "tag:peertube-web",
        "tag:stalwart",
        "tag:authelia",
        "tag:lemmy-web",
        "tag:console-web",
      ],
      "dst": ["tag:db-postgres"],
      "ip":  ["tcp:5432"],
    },

    // Postgres HA (optional): node-to-node on TCP/5432. Every Postgres node
    // and the pg-router carry tag:db-postgres, so this one self-grant covers
    // BOTH the standby -> primary streaming-replication connection and the
    // pg-router -> current-primary hop. Harmless for a single node (nothing
    // dials it). See README "Postgres high availability".
    {
      "src": ["tag:db-postgres"],
      "dst": ["tag:db-postgres"],
      "ip":  ["tcp:5432"],
    },

    // App tiers reach the main shared Redis on TCP/6379 only.
    // GoToSocial is intentionally omitted — it has no Redis dependency.
    // Lemmy is intentionally omitted — it uses Postgres only.
    // Stalwart is included — provision-stalwart wires its in-memory store
    // to Redis logical DB 3 on this instance.
    // Authelia is intentionally NOT here: its session store runs in the
    // dedicated redis-authelia instance on TCP/6380 (next grant), so a
    // compromised app tier cannot reach SSO session state (SECURITY.md §5.7).
    {
      "src": [
        "tag:pixelfed-web", "tag:pixelfed-worker",
        "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
        "tag:diaspora-web",
        "tag:funkwhale-web", "tag:funkwhale-worker",
        "tag:peertube-web",
        "tag:stalwart",
      ],
      "dst": ["tag:db-redis"],
      "ip":  ["tcp:6379"],
    },

    // Authelia's dedicated session Redis (same tailnet node as the main
    // Redis — it shares the ts-redis sidecar — but a different port, so
    // this grant is the only path to it).
    {
      "src": ["tag:authelia"],
      "dst": ["tag:db-redis"],
      "ip":  ["tcp:6380"],
    },

    // Stalwart mail server — reached by the L4 edge on all mail ports plus
    // HTTPS for MTA-STS/autoconfig/autodiscover pass-through, and by the
    // reverse proxy on JMAP/admin port 8080.
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:stalwart"],
      "ip":  ["tcp:25", "tcp:465", "tcp:587", "tcp:143", "tcp:993", "tcp:443", "tcp:8080"],
    },

    // Authelia SSO portal — reached by the reverse proxy on TCP/9091, and by
    // app tiers that use OIDC (GTS, Mastodon, Funkwhale, PeerTube).
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:authelia"],
      "ip":  ["tcp:9091"],
    },
    {
      "src": [
        "tag:gotosocial-web",
        "tag:mastodon-web",
        // Funkwhale omitted — no OIDC/SSO support upstream (S3-only stack).
        "tag:peertube-web",
      ],
      "dst": ["tag:authelia"],
      "ip":  ["tcp:9091"],
    },

    // Host reverse proxy reaches each public-facing app web tier on the
    // tier's INTERNAL listen port (not 80/443 — that's the proxy's public
    // side). Tag your host machine with tag:reverse-proxy for this to
    // apply. Ports match what each container listens on inside its
    // sidecar netns; see each app's docker-compose.yml.
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:pixelfed-web"],
      "ip":  ["tcp:80"],
    },
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:mastodon-web", "tag:diaspora-web"],
      "ip":  ["tcp:3000"],
    },
    // Console is TAILNET-ONLY (no WAN, no reverse-proxy route). The sidecar
    // fronts the app itself via `tailscale serve` on :443 with a real cert
    // (see apps/console/ts-serve.json). Operators' own devices reach it here —
    // tailscale serve traffic still honors the ACL, so this grant is required.
    {
      "src": ["autogroup:admin"],
      "dst": ["tag:console-web"],
      "ip":  ["tcp:443"],
    },
    // Console is the FLEET OBSERVER — its dashboard probes every service
    // (http / pg / redis / nodeinfo). Broad reach, like tag:nvimide; tighten to
    // specific tags/ports later if desired.
    {
      "src": ["tag:console-web"],
      "dst": ["*"],
      "ip":  ["*"],
    },
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:mastodon-streaming"],
      "ip":  ["tcp:4000"],
    },
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:funkwhale-web"],
      "ip":  ["tcp:80"],
    },
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:gotosocial-web"],
      "ip":  ["tcp:8080"],
    },
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:peertube-web"],
      "ip":  ["tcp:9000"],
    },

    // PeerTube RTMP live ingest. By default, only the host nginx (which
    // can stream-proxy public :1935 to here) and admins reach the RTMP
    // listener. Uncomment the streamer block to let tagged streaming
    // boxes publish directly over the tailnet without a public proxy.
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:peertube-web"],
      "ip":  ["tcp:1935"],
    },
    // {
    //   "src": ["tag:streamer"],
    //   "dst": ["tag:peertube-web"],
    //   "ip":  ["tcp:1935"],
    // },

    // Lemmy — reverse proxy reaches the internal nginx aggregator on port 80.
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:lemmy-web"],
      "ip":  ["tcp:80"],
    },

    // App tiers reach Garage S3 API on TCP/3900.
    // Add new app tags here when you bring them up.
    {
      "src": [
        "tag:pixelfed-web", "tag:pixelfed-worker",
        "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
        "tag:diaspora-web",
        "tag:funkwhale-web", "tag:funkwhale-worker",
        "tag:gotosocial-web",
        "tag:peertube-web",
        "tag:lemmy-web",    // pict-rs stores images in Garage S3
        "tag:stalwart",
        "tag:db-postgres",  // shared-db pg-backup service uses Garage too
      ],
      "dst": ["tag:garage"],
      "ip":  ["tcp:3900"],
    },

    // Host reverse proxy reaches Garage web endpoint (TCP/3902) to serve
    // public media. Port 3902 is the [s3_web] endpoint in garage.toml —
    // it serves anonymous reads from website-enabled buckets. Separate from
    // the S3 API (3900) which requires signed requests and is not for
    // public browsers.
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:garage"],
      "ip":  ["tcp:3902"],
    },

    // Highly-available S3 endpoint (optional, multi-node). When apps target
    // the S3 API through the reverse-proxy load-balancer (GARAGE_S3_ENDPOINT_NAME
    // = the reverse-proxy host; see nginx/sites-available/garage-s3.conf), the
    // LB needs to reach every node's S3 API upstream (TCP/3900)...
    {
      "src": ["tag:reverse-proxy"],
      "dst": ["tag:garage"],
      "ip":  ["tcp:3900"],
    },
    // ...and the app tiers need to reach the LB on the reverse-proxy host.
    // (Only needed when GARAGE_S3_ENDPOINT_NAME points at the reverse proxy;
    // apps that dial a Garage node directly use the tag:garage:3900 grant
    // below instead.)
    {
      "src": [
        "tag:pixelfed-web", "tag:pixelfed-worker",
        "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
        "tag:diaspora-web",
        "tag:funkwhale-web", "tag:funkwhale-worker",
        "tag:gotosocial-web",
        "tag:peertube-web",
        "tag:lemmy-web",
        "tag:stalwart",
        "tag:db-postgres",
      ],
      "dst": ["tag:reverse-proxy"],
      "ip":  ["tcp:3900"],
    },

    // Garage cluster RPC (TCP/3901) — node-to-node replication and gossip.
    // REQUIRED for a multi-node cluster; without it the nodes cannot form a
    // cluster and layout apply hangs waiting for peers. Harmless for a
    // single node (nothing dials it). Every Garage node carries tag:garage,
    // so this grant lets each node reach every other node on 3901 only.
    {
      "src": ["tag:garage"],
      "dst": ["tag:garage"],
      "ip":  ["tcp:3901"],
    },

    // Admins (you, on your laptop) reach everything for debugging.
    {
      "src": ["autogroup:admin"],
      "dst": ["*"],
      "ip":  ["*"],
    },
  ],

  // Optional: SSH access from admins to any tagged node, for break-glass.
  // The Tailscale sidecars in this repo do not run sshd by default, so this
  // only matters if you exec a shell inside one. Leave commented unless you
  // know you need it.
  // "ssh": [
  //   {
  //     "action": "accept",
  //     "src":    ["autogroup:admin"],
  //     "dst":    ["tag:db-postgres", "tag:db-redis",
  //                "tag:pixelfed-web", "tag:pixelfed-worker",
  //                "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
  //                "tag:diaspora-web",
  //                "tag:funkwhale-web", "tag:funkwhale-worker",
  //                "tag:gotosocial-web",
  //                "tag:peertube-web"],
  //     "users":  ["root", "autogroup:nonroot"],
  //   },
  // ],
}
