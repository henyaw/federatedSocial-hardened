# ============================================================================
# federated-social — operator configuration
# ============================================================================
# Copy this file to .env and edit. Every compose file in this repo reads from
# the .env in its working directory; ./bootstrap.sh up <stack> auto-creates
# the per-stack symlink the first time you bring a stack up, so no manual
# `ln -s` is needed. (If you prefer to call docker compose directly without
# bootstrap.sh, you can create the symlinks yourself: ln -s ../.env <stack>/.env)
#
# Anything marked "GENERATE" must be filled with a freshly generated secret
# before first boot. Generation one-liners are inline next to each one.
# ============================================================================


# ----------------------------------------------------------------------------
# Tailscale — pick ONE of the two auth methods below.
# ----------------------------------------------------------------------------
# Method 1 (recommended): OAuth client.
#   Create at https://login.tailscale.com/admin/settings/oauth
#
#   IMPORTANT — the OAuth client needs THREE scopes, not the one that the
#   upstream tailscale/tailscale container docs suggest. With only
#   "Devices: Core (write)", node creation succeeds but tag application
#   fails with a confusing 403 ("calling actor does not have enough
#   permissions"). The implicit auth-key minting that happens when you
#   pass an OAuth client secret as TS_AUTHKEY requires the auth-keys
#   scope under the hood.
#
#   Required scopes (all three; under "Custom scopes"):
#     - Devices  -> Core         -> Read + Write   (assign every stack tag)
#     - Keys     -> Auth Keys    -> Read + Write   (assign every stack tag)
#     - Keys     -> OAuth Keys   -> Read + Write
#
#   Tag list to assign to both Devices/Core and Keys/Auth Keys (every tag
#   referenced in acl.example.hujson):
#     tag:db-postgres  tag:db-redis
#     tag:pixelfed-web  tag:pixelfed-worker
#     tag:mastodon-web  tag:mastodon-streaming  tag:mastodon-sidekiq
#     tag:diaspora-web
#     tag:funkwhale-web  tag:funkwhale-worker
#     tag:gotosocial-web
#     tag:peertube-web
#     tag:stalwart  tag:stalwart-redis
#     tag:authelia
#     tag:lemmy-web
#
#   Sidecars are ephemeral — "docker compose down" self-cleans them from
#   the admin console. The "?ephemeral=true" suffix on the auth key (in
#   compose) is how this is enabled, and is only valid for OAuth client
#   secrets, not for pre-generated auth keys.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

# Method 2: pre-generated auth key (uncomment to use, leave OAuth blank).
#   Generate at admin console -> Settings -> Keys. Make it Reusable +
#   Ephemeral + Preapproved, tagged with every tag this stack uses.
#   Do NOT append "?ephemeral=true" — auth keys reject query suffixes
#   (the compose template handles this automatically when TS_AUTHKEY is set).
#   Auth keys expire in 90 days by default; set yourself a calendar
#   reminder, or use the OAuth path which has no rotation overhead.
# TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Your tailnet's MagicDNS suffix. Visible in the admin console DNS panel.
# Looks like: tailfe8c.ts.net  (anonymous tailnets) or yourname.ts.net.
TS_TAILNET=tailfe8c.ts.net

# Tailscale sidecar image version. All sidecars in every stack share this pin.
# Pin and bump deliberately — check release notes before upgrading.
TAILSCALE_VERSION=v1.98.4

# Path to the custom Caddy binary (must include caddy-l4 module for mail edge).
# Used by: ./bootstrap.sh up caddy
# See caddy/README.md for download and installation instructions.
CADDY_BIN=/usr/local/bin/caddy


# ----------------------------------------------------------------------------
# MagicDNS hostnames — one per sidecar
# ----------------------------------------------------------------------------
# Pick anything memorable. These become the device names in your Tailscale
# admin console and the hostnames apps use to reach each other. They are
# stable across restarts even though tailnet IPs change.

# Shared infra
# DB_MAGIC_NAME is the app-facing Postgres endpoint — the name every app dials.
# Single node: it IS the one Postgres node (PG_NODE_MAGIC_NAME defaults to the
# same value). HA: it names the pg-router sidecar, which forwards to whichever
# node is currently primary; the PG nodes take their own PG_NODE_MAGIC_NAME
# (pg-primary / pg-standby). See the Postgres HA block below.
DB_MAGIC_NAME=pgsql-prod
REDIS_MAGIC_NAME=redis-prod
# GARAGE_MAGIC_NAME is THIS host's Garage node name. Single node: leave as
# "garage". Three-node cluster: give each host a distinct name (garage-1,
# garage-2, garage-3) in that host's .env. Apps reach object storage at
# ${GARAGE_MAGIC_NAME}.${TS_TAILNET}:3900, so on an app host set this to the
# node you want that host's apps to talk to (any node serves any request; it
# proxies internally). See the Garage cluster block lower down.
GARAGE_MAGIC_NAME=garage

# Public-facing app web tiers (your reverse proxy points here)
PIXELFED_WEB_MAGIC_NAME=pixelfed
MASTODON_WEB_MAGIC_NAME=mastodon
MASTODON_STREAMING_MAGIC_NAME=mastodon-streaming
DIASPORA_WEB_MAGIC_NAME=diaspora
FUNKWHALE_WEB_MAGIC_NAME=funkwhale
FUNKWHALE_WORKER_MAGIC_NAME=funkwhale-worker
GOTOSOCIAL_WEB_MAGIC_NAME=gotosocial
PEERTUBE_WEB_MAGIC_NAME=peertube
STALWART_MAGIC_NAME=stalwart
AUTHELIA_MAGIC_NAME=authelia
LEMMY_MAGIC_NAME=lemmy

# Internal worker tiers (no external traffic)
PIXELFED_WORKER_MAGIC_NAME=pixelfed-worker
MASTODON_SIDEKIQ_MAGIC_NAME=mastodon-sidekiq
# Stalwart's OWN dedicated Redis instance (internal only — Stalwart dials
# this, nothing public-facing does). Single node: it IS the one Redis node
# (STALWART_REDIS_NODE_MAGIC_NAME defaults to the same value). HA: it names
# the stalwart-redis-router sidecar. See the Stalwart Redis HA block below.
STALWART_REDIS_MAGIC_NAME=stalwart-redis


# ----------------------------------------------------------------------------
# Postgres — shared instance, per-app users/databases
# ----------------------------------------------------------------------------
# Superuser password. Used by the postgres container and by the init script
# to create per-app users/databases. Operators rarely touch this directly.
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Postgres high availability (optional) ---------------------------------
# Single-node by default: leave PG_ROLE unset and skip this block entirely.
# Purpose is UPTIME across a whole-host / datacenter outage (not backups) —
# a hot standby on a SECOND host, and a router that always points apps at the
# current primary. Manual promotion (you run one command in an incident).
# Full walkthrough + failover runbook: README "Postgres high availability".
#
# This node's OWN Postgres MagicDNS name. Single node: leave unset (defaults
# to "pgsql-prod"). HA: set per-host (e.g. pg-primary on the primary host,
# pg-standby on the standby host). DB_MAGIC_NAME then names the pg-router
# that apps dial, NOT a specific PG node.
PG_NODE_MAGIC_NAME=pgsql-prod
# Role of THIS host's Postgres: "primary" (default) or "standby". A standby
# host clones from the primary and streams; it runs Postgres only (no Redis).
PG_ROLE=primary
# The CURRENT primary's node name. Used by the standby (clone source) and by
# pg-router (where to send app traffic). On failover you promote the standby,
# set this to the promoted node, and re-run 'up pg-router'.
PG_PRIMARY_MAGIC_NAME=pg-primary
# Streaming-replication role. The name is also fixed in shared-db/pg_hba.conf,
# so keep it "replicator" or edit both. Password MUST be URL-safe-ish and is
# embedded in the standby's primary_conninfo. Generate: openssl rand -hex 32
REPLICATION_USER=replicator
REPLICATION_PASSWORD=
# Physical replication slot name (primary retains WAL for the standby).
PG_REPLICATION_SLOT=standby_slot

# Per-app database credentials. The shared-db init script creates each
# user+database on first boot if they don't exist; bootstrap.sh provision-db
# handles it idempotently on any boot.
#
# Password generation: use openssl rand -base64 24 for most apps. However,
# Funkwhale embeds its password directly in a DATABASE_URL connection string,
# so slashes and plus signs in the password will be mis-parsed as URI path
# separators. Use openssl rand -hex 32 for FUNKWHALE_DB_PASSWORD.
PIXELFED_DB_NAME=pixelfed
PIXELFED_DB_USER=pixelfed
PIXELFED_DB_PASSWORD=

MASTODON_DB_NAME=mastodon
MASTODON_DB_USER=mastodon
MASTODON_DB_PASSWORD=

DIASPORA_DB_NAME=diaspora_production
DIASPORA_DB_USER=diaspora
DIASPORA_DB_PASSWORD=

FUNKWHALE_DB_NAME=funkwhale
FUNKWHALE_DB_USER=funkwhale
# IMPORTANT: use hex, not base64. Funkwhale embeds this in a DATABASE_URL;
# slashes from base64 output break URI parsing. Generate: openssl rand -hex 32
FUNKWHALE_DB_PASSWORD=


# ----------------------------------------------------------------------------
# Redis — two password-authenticated instances (SECURITY.md §5.7)
# ----------------------------------------------------------------------------
# Redis logical DB indices are a namespacing convention, NOT a security
# boundary — any authenticated client can SELECT any index. So the stack
# runs TWO instances behind the same ts-redis sidecar:
#
#   :6379  main    — fediverse apps. Password below.
#   :6380  authelia — SSO session store ONLY. Its own password, and a
#                     separate port-scoped ACL grant (only tag:authelia may
#                     reach 6380), so a compromised app tier cannot read or
#                     forge SSO sessions.
#
# Stalwart does NOT live here — it has its OWN dedicated Redis instance
# (STALWART_REDIS_* below, stalwart-redis/), so it can get the HA treatment
# (README "Stalwart Redis high availability") without dragging the shared
# apps' Redis into it, and without the per-app-client-support gaps that
# would come from trying to make THIS instance highly available too. Redis
# stays intentionally single-instance for the apps below (see CLAUDE.md's
# open design questions) — it's cache/queue for them, and losing it just
# forces a re-login or requeue.
#
# (Why not per-app Redis ACL users: ACLs cannot confine SELECT to an index,
# and Pixelfed/PeerTube only support password auth — see the comment in
# shared-db/docker-compose.yml.)
#
# Logical DB allocation on the MAIN instance (0-2 — fediverse apps only now):
#   pixelfed uses 0 cache, 1 session, 2 pulse; mastodon, diaspora, funkwhale,
#   peertube share 0.
#
# IMPORTANT: use hex passwords (openssl rand -hex 32). Several apps embed
# the password in a redis:// URL, where base64's / and + mis-parse.
REDIS_APPS_PASSWORD=
REDIS_AUTHELIA_PASSWORD=


# ----------------------------------------------------------------------------
# Garage — shared S3-compatible object storage
# ----------------------------------------------------------------------------
# Bring up garage/ after shared-db/ and before any app that uses object
# storage. After 'up', run: ./bootstrap.sh provision-garage
# That command initialises the cluster layout, creates all app buckets,
# creates one access key PER APP — each scoped to only its own app's
# buckets (SECURITY.md §5.7) — and prints the <APP>_GARAGE_KEY_ID/SECRET
# pairs. Paste those values into the block below, then set S3 opt-in flags
# for each app you want to migrate (see each app's section below).

# Garage image version. Pin and bump deliberately.
# See https://git.deuxfleurs.fr/Deuxfleurs/garage/releases for tags.
GARAGE_VERSION=v1.0.1

# Capacity hint (not enforced — used by Garage for load distribution across
# nodes). Set to your approximate available data disk space ON THIS NODE.
GARAGE_CAPACITY=100G

# S3 region name presented to clients. Apps in this stack default to this.
GARAGE_REGION=garage

# S3 API endpoint name — the MagicDNS name apps/backups use to reach the S3
# API (:3900). Apps build http://${GARAGE_S3_ENDPOINT_NAME}.${TS_TAILNET}:3900.
#   - Single node (default): leave "garage" (equals GARAGE_MAGIC_NAME).
#   - Multi-node cluster for HA: set this to your REVERSE-PROXY host's MagicDNS
#     name and run the S3 load-balancer (nginx/sites-available/garage-s3.conf
#     or the caddy/Caddyfile layer4 block). Then app -> S3 traffic fails over
#     across nodes instead of depending on one. See README "Highly available
#     S3 endpoint". (PeerTube is set separately via PEERTUBE_OBJECT_STORAGE_
#     ENDPOINT, which needs an IP, not a name — point it at the LB host's
#     Tailscale IP.)
GARAGE_S3_ENDPOINT_NAME=garage

# Cluster RPC secret — shared by ALL nodes (it is the cluster identifier;
# nodes with different secrets refuse to talk). Generate ONCE and copy the
# same value into every node's .env. Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=

# ---- Multi-node cluster (optional) -----------------------------------------
# Leave GARAGE_REPLICATION_FACTOR unset/1 for a single-node store (default) —
# the three cluster vars below are then ignored and you can skip this block.
#
# For a THREE-SERVER cluster, run this garage/ stack on each of the 3 hosts.
# Each host has its OWN .env; these values split into per-host and shared:
#
#   PER-HOST (differ on each server):
#     GARAGE_MAGIC_NAME  — this node's MagicDNS name (garage-1 / garage-2 /
#                          garage-3). Set it in the MagicDNS section above.
#     GARAGE_ZONE        — this node's failure domain (below). Give each host
#                          a distinct zone so Garage spreads replicas across
#                          them. (Also used to build GARAGE_CLUSTER_ZONES.)
#     GARAGE_CAPACITY    — that node's data-disk size (above).
#
#   SHARED (identical on all 3 servers):
#     GARAGE_RPC_SECRET             — above.
#     GARAGE_REPLICATION_FACTOR     — 3 for a 3-node cluster (three copies;
#                                     tolerates losing 2 nodes without data
#                                     loss). Must match on every node.
#     GARAGE_BOOTSTRAP_PEERS        — filled in AFTER first boot (see below).
#     GARAGE_CLUSTER_ZONES          — optional name:zone map (see below).
#
# Bring-up (full walkthrough in README "Multi-node Garage cluster"):
#   1. Set GARAGE_REPLICATION_FACTOR=3 + the per-host vars on all 3 hosts.
#   2. `./bootstrap.sh up garage` on each host (boots the node; it prints the
#      node's peer id — or run `./bootstrap.sh garage-peer-id`).
#   3. Join the 3 peer ids into GARAGE_BOOTSTRAP_PEERS (comma-separated) and
#      set the SAME value in all 3 .env files.
#   4. `./bootstrap.sh up garage` again on each host (reboots with peers).
#   5. `./bootstrap.sh provision-garage` ONCE on any host — it waits for all
#      nodes, assigns the layout, and creates buckets/keys.
#
# Zone label for this node's layout role. Distinct per host in a cluster
# (dc1 / dc2 / dc3); for single-node any value works.
GARAGE_ZONE=dc1
#
# Replication factor. 1 = single node (default). 3 = three-way replication
# across a 3-node cluster. Must be identical on every node.
GARAGE_REPLICATION_FACTOR=1
#
# Bootstrap peers — the full peer id of every node, comma-separated, in the
# form <node-pubkey>@<magicdns-name>:3901. BLANK on first boot; fill it after
# step 2 above (pubkeys are minted on first boot). Same value on all hosts.
# Example:
#   GARAGE_BOOTSTRAP_PEERS=abc123...@garage-1.tailfe8c.ts.net:3901,def456...@garage-2.tailfe8c.ts.net:3901,ghi789...@garage-3.tailfe8c.ts.net:3901
GARAGE_BOOTSTRAP_PEERS=
#
# Optional name→zone map for provision-garage's layout assignment, space-
# separated "name:zone" pairs. Only needed if provision-garage runs on a host
# whose GARAGE_ZONE differs from the zone you want other nodes assigned to.
# If unset, each node is assigned to a zone equal to its own name. Example:
#   GARAGE_CLUSTER_ZONES=garage-1:dc1 garage-2:dc2 garage-3:dc3
GARAGE_CLUSTER_ZONES=

# Per-app access keys — printed ONCE by 'bootstrap.sh provision-garage'
# (secrets are not redisplayable; rotate the key and re-run if lost).
# Leave blank until you run that command. Each key can reach ONLY its own
# app's buckets: a stolen Pixelfed key cannot read Mastodon's media or the
# private mail bucket. The stalwart-mail key is held by Stalwart alone;
# pg-backups by the backup scripts alone.
PIXELFED_GARAGE_KEY_ID=
PIXELFED_GARAGE_KEY_SECRET=
MASTODON_GARAGE_KEY_ID=
MASTODON_GARAGE_KEY_SECRET=
GOTOSOCIAL_GARAGE_KEY_ID=
GOTOSOCIAL_GARAGE_KEY_SECRET=
FUNKWHALE_GARAGE_KEY_ID=
FUNKWHALE_GARAGE_KEY_SECRET=
PEERTUBE_GARAGE_KEY_ID=
PEERTUBE_GARAGE_KEY_SECRET=
LEMMY_GARAGE_KEY_ID=
LEMMY_GARAGE_KEY_SECRET=
STALWART_GARAGE_KEY_ID=
STALWART_GARAGE_KEY_SECRET=
PG_BACKUP_GARAGE_KEY_ID=
PG_BACKUP_GARAGE_KEY_SECRET=

# ---- Postgres backups (backup/pg-backup.sh) --------------------------------
# pg-backup.sh dumps all databases and ships the gzip to the pg-backups bucket
# in Garage. These have sane defaults — override only if you want to. See the
# README "Backups" section for the cron line, a test run, and recovery.
# How many days of backups to keep in the bucket (older ones are pruned).
PG_BACKUP_RETENTION_DAYS=14
# Bucket name (provision-garage already creates pg-backups).
PG_BACKUP_BUCKET=pg-backups


# ----------------------------------------------------------------------------
# Email (SMTP) — shared relay for the whole stack
# ----------------------------------------------------------------------------
# Fill these ONCE and every app sends through the same relay (SendGrid,
# Mailgun, Postmark, Amazon SES, your own Postfix, etc.). Each app's compose
# file maps these into the app-specific variable names it expects.
#
# Without a working relay, password resets and signup confirmations don't
# work. This is the single most common cause of "I'm locked out of my own
# instance" — set it up before you create your admin user.
#
# Leave SMTP_HOST blank to run without email:
#   - Mastodon / GoToSocial / PeerTube: simply send no mail.
#   - Funkwhale: logs mail to the container stdout (consolemail).
#   - Pixelfed: set PIXELFED_MAIL_DRIVER=log (the default) — mail is written
#     to the Laravel log instead of sent.
#
# Per-app SENDER addresses live in each app's section below (they differ by
# domain). The relay credentials here are shared.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Default display name on outgoing mail. Apps that support a separate sender
# name use this; apps that only take an address ignore it.
SMTP_FROM_NAME=Federated Social


# ----------------------------------------------------------------------------
# Pixelfed
# ----------------------------------------------------------------------------
# Public domain (no scheme, no trailing slash).
PIXELFED_DOMAIN=pixelfed.example.com

# Image version to deploy. Pin this and bump deliberately — Pixelfed runs DB
# migrations automatically on start, so floating "latest" tags can break things
# on a surprise upgrade (and the web/worker tiers could drift onto different
# builds). The format is <php>-<pixelfed>-glitch.<image> and locks the PHP
# runtime too. Browse tags at:
#   https://github.com/pixelfed-glitch/pixelfed/pkgs/container/pixelfed
PIXELFED_VERSION=8.4-0.12.6-glitch.1.12.1

# Laravel APP_KEY. Must be a 32-byte base64 string.
# Generate: echo "base64:$(openssl rand -base64 32)"
PIXELFED_APP_KEY=

# ---- Instance identity ----
# Display name shown in the browser tab and UI header.
PIXELFED_APP_NAME=Pixelfed
# Admin domain — leave blank to use PIXELFED_DOMAIN.
PIXELFED_ADMIN_DOMAIN=
# Short description shown on the landing page and in federation directories.
PIXELFED_INSTANCE_DESCRIPTION=
# Public contact email shown on the About page.
PIXELFED_CONTACT_EMAIL=
# Set true to enable the contact form on the About page.
PIXELFED_CONTACT_FORM=false
# Trusted reverse-proxy CIDRs for X-Forwarded-For. 100.64.0.0/10 covers all
# Tailscale sidecars. Add your public proxy IP if your setup adds another hop.
PIXELFED_TRUST_PROXIES=100.64.0.0/10

# ---- Timezone and locale ----
# PHP app timezone — independent of the Docker container TZ.
# Valid values: https://www.php.net/timezones
PIXELFED_TIMEZONE=UTC
# UI locale. Must match a locale Pixelfed ships (e.g. en, de, fr, es, nl).
PIXELFED_LOCALE=en

# ---- Registration ----
PIXELFED_OPEN_REGISTRATION=false
# Set to true once SMTP is working — prevents spam signups.
PIXELFED_ENFORCE_EMAIL_VERIFICATION=false
# Curated onboarding: new signups require admin approval before the account
# activates. Set true to gate registration behind a manual review queue.
PIXELFED_CUR_REG=false

# ---- Federation ----
# Disable any of these to run a private / closed instance.
PIXELFED_ACTIVITY_PUB=true
PIXELFED_AP_REMOTE_FOLLOW=true
PIXELFED_AP_SHAREDINBOX=true
PIXELFED_AP_INBOX=true
PIXELFED_AP_OUTBOX=true
# Locale code to use when the primary locale (PIXELFED_LOCALE) is unavailable.
PIXELFED_FALLBACK_LOCALE=en
PIXELFED_ATOM_FEEDS=true
PIXELFED_NODEINFO=true
PIXELFED_WEBFINGER=true

# ---- Moderation ----
# Email an admin when a report is filed.
PIXELFED_REPORTS_EMAIL_ENABLED=false
# Comma-separated list of addresses to receive report emails.
PIXELFED_REPORTS_EMAIL_ADDRESSES=
# Auto-report posts detected as spam.
PIXELFED_REPORTS_EMAIL_AUTOSPAM=false

# ---- Content ----
# Ephemeral 24-hour stories. Requires object storage when PIXELFED_LOCAL_AVATAR_TO_CLOUD=true.
PIXELFED_STORIES_ENABLED=false
# Blur NSFW-tagged media in public timelines.
PIXELFED_HIDE_NSFW=false

# ---- Email ----
# Uses the shared SMTP relay above. Leave the driver as 'log' to write mail to
# the Laravel log (no relay needed); set to 'smtp' once SMTP_HOST is filled in.
# NOTE: Pixelfed has no password-reset CLI — without working email the only
# recovery is direct DB surgery. Configure SMTP before going live.
# MAIL_ENCRYPTION: 'tls' for port 587 (STARTTLS), 'ssl' for port 465.
PIXELFED_MAIL_DRIVER=log
PIXELFED_MAIL_ENCRYPTION=tls
PIXELFED_MAIL_FROM_ADDRESS=noreply@pixelfed.example.com

# ---- Object storage (S3 via Garage) — opt in ----
# Set PIXELFED_ENABLE_CLOUD=true to store uploads in Garage instead of the
# local pixelfed-storage volume. Requires PIXELFED_GARAGE_KEY_ID and
# PIXELFED_GARAGE_KEY_SECRET to be set above, and `bootstrap.sh
# provision-garage` to have run (it creates the pixelfed-media bucket and
# the key, scoped to that bucket only).
PIXELFED_ENABLE_CLOUD=false
# Also push avatars to cloud storage (recommended when cloud is enabled).
PIXELFED_LOCAL_AVATAR_TO_CLOUD=false
# Delete local copies after upload — saves disk but requires cloud availability.
PIXELFED_DELETE_LOCAL_AFTER_CLOUD=false
PIXELFED_S3_BUCKET=pixelfed-media
# Public URL for Pixelfed media. REQUIRED when PIXELFED_ENABLE_CLOUD=true.
# Garage is only reachable inside the Tailscale tailnet. When this is blank,
# Pixelfed embeds http://garage.<tailnet>:3900/... URLs in page HTML, which
# public browsers cannot resolve — images will silently fail to load.
# Deploy the commented media block at the bottom of nginx/sites-available/pixelfed.conf
# (or the matching block in caddy/Caddyfile) and set this to that domain:
#   PIXELFED_S3_URL=https://media.example.com
# Also ensure MASTODON_S3_ALIAS_HOST is set if Mastodon cloud is enabled.
PIXELFED_S3_URL=


# ----------------------------------------------------------------------------
# Mastodon
# ----------------------------------------------------------------------------
# Pin and bump deliberately — check release notes before upgrading.
MASTODON_VERSION=v4.5.11

# Public domain for web (no scheme, no trailing slash).
MASTODON_DOMAIN=mastodon.example.com

# Mastodon secrets. Each must be a long random hex string.
# Generate each with: docker run --rm ghcr.io/mastodon/mastodon bin/rake secret
# Generate each with: docker run --rm ghcr.io/mastodon/mastodon bundle exec rails secret
MASTODON_SECRET_KEY_BASE=
MASTODON_OTP_SECRET=

# VAPID keypair for Web Push notifications.
# Generate: docker run --rm ghcr.io/mastodon/mastodon bin/rake mastodon:webpush:generate_vapid_key
# Then paste the two emitted lines below.
MASTODON_VAPID_PRIVATE_KEY=
MASTODON_VAPID_PUBLIC_KEY=

# ActiveRecord encryption keys (Mastodon 4.3+). Three 32-byte hex strings.
# Generate: docker run --rm ghcr.io/mastodon/mastodon bin/rails db:encryption:init
# Then paste the three emitted values.
MASTODON_AR_ENC_DETERMINISTIC_KEY=
MASTODON_AR_ENC_KEY_DERIVATION_SALT=
MASTODON_AR_ENC_PRIMARY_KEY=

# Email. Relay credentials come from the shared SMTP_* block above; only the
# sender address is per-app here. Without SMTP, signup confirmations fail.
MASTODON_SMTP_FROM_ADDRESS=notifications@mastodon.example.com

# Object storage (S3 via Garage) — opt in.
# Set MASTODON_S3_ENABLED=true to store media in Garage. Requires
# MASTODON_GARAGE_KEY_ID and MASTODON_GARAGE_KEY_SECRET to be set above.
MASTODON_S3_ENABLED=false
MASTODON_S3_BUCKET=mastodon-media
# Public hostname for Mastodon media. REQUIRED when MASTODON_S3_ENABLED=true.
# Same problem as PIXELFED_S3_URL: blank = tailnet URLs embedded in pages =
# images unreachable by public browsers. Hostname only, no scheme (Mastodon
# constructs the https:// URL itself). See the media block at the bottom of
# nginx/sites-available/mastodon.conf (or caddy/Caddyfile) for the proxy
# snippet. Example: mastodon-media.example.com
MASTODON_S3_ALIAS_HOST=

# ---- SSO via OIDC (Authelia) — optional ----
# Mastodon uses its bundled omniauth_openid_connect; no extra image needed.
# To enable:
#   1. set MASTODON_OIDC_CLIENT_SECRET to a random string: openssl rand -hex 32
#   2. set MASTODON_OIDC_ENABLED=true and fill IDP name + issuer
#   3. up authelia (renders the matching client) then up mastodon
# bootstrap renders the Authelia client's redirect_uri (from MASTODON_DOMAIN)
# and the pbkdf2 hash of the secret — neither is committed.
MASTODON_OIDC_ENABLED=false
MASTODON_OIDC_DISPLAY_NAME=
MASTODON_OIDC_ISSUER=
MASTODON_OIDC_CLIENT_ID=mastodon
MASTODON_OIDC_CLIENT_SECRET=


# ----------------------------------------------------------------------------
# Diaspora
# ----------------------------------------------------------------------------
# Pin and bump deliberately — check release notes before upgrading.
DIASPORA_VERSION=0.9.1.0

# Public URL with scheme and trailing slash. DO NOT change this after first
# boot — it is hardcoded into the database on initial setup.
DIASPORA_URL=https://diaspora.example.com/

# Email. Diaspora maps env vars onto its config tree (the same convention the
# working DIASPORA_URL/REDIS vars use): configuration.mail.* -> CONFIGURATION_
# MAIL_*. Relay host/port/user/password come from the shared SMTP_* block; only
# the toggle and sender address are per-app here. Set to true once SMTP is
# configured — Diaspora requires email for signups and password resets.
DIASPORA_MAIL_ENABLE=false
DIASPORA_MAIL_SENDER_ADDRESS=noreply@diaspora.example.com


# ----------------------------------------------------------------------------
# Funkwhale
# ----------------------------------------------------------------------------
# Public domain (no scheme, no trailing slash).
FUNKWHALE_DOMAIN=funkwhale.example.com

# Image version to deploy. Pin this and bump deliberately — schema migrations
# run automatically on start, so surprise upgrades can break things.
# Check https://docs.funkwhale.audio/changelog for latest release.
FUNKWHALE_VERSION=1.3.4

# Django secret key.
# Generate: openssl rand -base64 45
FUNKWHALE_DJANGO_SECRET_KEY=

# Email. Funkwhale (Django) takes a single connection-string instead of
# discrete host/port/user/password vars, so it can't read the shared SMTP_*
# block directly. Default below logs mail to container stdout (no relay).
# To use your relay, set this to the django-environ form:
#   smtp+tls://USER:PASSWORD@HOST:PORT      (STARTTLS, port 587)
#   smtp+ssl://USER:PASSWORD@HOST:PORT      (implicit TLS, port 465)
# URL-ENCODE special characters in USER/PASSWORD (@ -> %40, / -> %2F, etc.) —
# they are URI components and will mis-parse otherwise. Example:
#   smtp+tls://apikey:SG.aB%2FcD@smtp.sendgrid.net:587
FUNKWHALE_EMAIL_CONFIG=consolemail://
FUNKWHALE_DEFAULT_FROM_EMAIL=noreply@funkwhale.example.com

# Object storage (S3 via Garage) — opt in. Set true to store uploads in Garage
# (uses the per-app FUNKWHALE_GARAGE_KEY_* + the funkwhale-music bucket). With the
# front nginx proxying media (PROXY_MEDIA), NO separate public media host is
# needed. NOTE: Funkwhale has no OpenID Connect/SSO support upstream — it does
# OAuth2 (as a provider) and LDAP only — so there is no Authelia SSO for it.
FUNKWHALE_S3_ENABLED=false
FUNKWHALE_S3_BUCKET=funkwhale-music


# ----------------------------------------------------------------------------
# GoToSocial
# ----------------------------------------------------------------------------
# Pin and bump deliberately — check release notes before upgrading.
GOTOSOCIAL_VERSION=0.21.2

# Public hostname (NO scheme, NO trailing slash). Despite the _URL suffix,
# GTS's `host` config takes a bare hostname like "social.example.com".
# DO NOT change this after first boot — it is baked into account URIs.
GOTOSOCIAL_URL=gotosocial.example.com

# Per-app DB credentials. Created automatically on first boot of shared-db/
# if the pg-data volume is empty. If shared-db has already run once, see
# README "Troubleshooting" for the one-line manual CREATE ROLE command.
# Generate: openssl rand -base64 24
GOTOSOCIAL_DB_NAME=gotosocial
GOTOSOCIAL_DB_USER=gotosocial
GOTOSOCIAL_DB_PASSWORD=

# Email. Relay credentials come from the shared SMTP_* block above; only the
# sender address is per-app here. Without SMTP, signup confirmations and
# password resets won't work.
GOTOSOCIAL_SMTP_FROM=noreply@gotosocial.example.com

# CIDR(s) of trusted reverse proxies — required so GTS reads the real client
# IP from X-Forwarded-For instead of seeing every request as from the tailnet
# hop. 100.64.0.0/10 is the Tailscale CGNAT range and covers all sidecars.
# IMPORTANT: setting this REPLACES GTS's built-in loopback trust, so include
# 127.0.0.1/32 explicitly when an L7 edge proxy lands on loopback (e.g. a
# `tailscale serve` / 127.0.0.1 hop in front of GTS) — otherwise GTS logs a
# "trusted-proxies is not set correctly" warning and mis-attributes client IPs.
GOTOSOCIAL_PROXY=127.0.0.1/32,100.64.0.0/10

# ---- Object storage (S3 via Garage) — opt in ----
# Leave GOTOSOCIAL_STORAGE_BACKEND=local to keep media on the local
# gotosocialuploads volume. Set to s3 to store media in Garage. Credentials
# are the per-app GOTOSOCIAL_GARAGE_KEY_ID / GOTOSOCIAL_GARAGE_KEY_SECRET
# above; `bootstrap.sh provision-garage` creates the gotosocial-media bucket
# and the key (scoped to that bucket only).
GOTOSOCIAL_STORAGE_BACKEND=local
GOTOSOCIAL_S3_BUCKET=gotosocial-media
# proxy=false redirects clients to the public media URL below (lighter, needs
# the URL). proxy=true streams media through GTS itself (no URL needed, but
# every fetch hits the app).
GOTOSOCIAL_S3_PROXY=false
# Public media URL. REQUIRED when backend=s3 and proxy=false. MUST be its own
# domain, separate from other apps' media domains — each media domain maps to
# exactly one Garage bucket via the Caddy/nginx Host rewrite. Deploy the media
# block at the bottom of nginx/sites-available/gotosocial.conf (or caddy/Caddyfile)
# that rewrites Host to gotosocial-media.web.garage.local. Example:
#   GOTOSOCIAL_S3_REDIRECT_URL=https://gts-media.example.com
GOTOSOCIAL_S3_REDIRECT_URL=

# ---- SSO via Authelia OIDC (opt-in) ----------------------------------------
# Leave ENABLED=false to use local accounts only. To turn on SSO:
#   1. set GOTOSOCIAL_OIDC_CLIENT_SECRET to a random string: openssl rand -hex 32
#   2. set ENABLED=true, IDP_NAME, and ISSUER (your Authelia portal URL)
#   3. recreate both: ./bootstrap.sh up authelia && ./bootstrap.sh up gotosocial
# The gotosocial OIDC client already lives in authelia/configuration.yml;
# bootstrap renders its redirect_uri (from GOTOSOCIAL_URL) and the pbkdf2 hash
# of the secret above into the gitignored runtime config — no manual editing,
# nothing secret committed. GTS reads OIDC from these env vars only (no admin
# UI). Scopes use the GTS default [openid,profile,email,groups]. ISSUER =
# Authelia portal URL. ADMIN_GROUPS = group whose members become GTS admins.
# LINK_EXISTING = match an OIDC identity to a local account by email.
GOTOSOCIAL_OIDC_ENABLED=false
GOTOSOCIAL_OIDC_IDP_NAME=
GOTOSOCIAL_OIDC_ISSUER=
GOTOSOCIAL_OIDC_CLIENT_ID=gotosocial
GOTOSOCIAL_OIDC_CLIENT_SECRET=
GOTOSOCIAL_OIDC_LINK_EXISTING=true
GOTOSOCIAL_OIDC_ADMIN_GROUPS=admins


# ----------------------------------------------------------------------------
# Stalwart Mail Server
# ----------------------------------------------------------------------------
# Pin and bump deliberately — check release notes before upgrading.
# v0.16.7 is the validated baseline for this repo's config.json.
STALWART_VERSION=v0.16.7

# BASE mail domain — the domain after the @ in addresses (e.g. example.com,
# NOT mail.example.com). Used by the L4 edge caddy.json SNI fan-out on :443
# to route mta-sts.$STALWART_DOMAIN, autoconfig.$STALWART_DOMAIN, and
# autodiscover.$STALWART_DOMAIN to Stalwart. If your addresses are
# user@example.com, set this to example.com.
STALWART_DOMAIN=example.com

# Stalwart hostname — the MX record target and TLS certificate name. This is
# configured in the Stalwart admin UI (not via env var), but document it here
# so it's easy to find. Typically: mail.example.com
STALWART_HOSTNAME=mail.example.com

# Fallback admin credentials. Used ONLY if the Postgres database is empty
# (i.e. first boot). After Stalwart writes its config to Postgres, the
# fallback credentials are ignored. Change them via the admin UI.
# Generate: openssl rand -base64 24
STALWART_FALLBACK_ADMIN_SECRET=

# Password of the PERSISTENT admin@STALWART_DOMAIN account, which is what
# 'provision-stalwart' authenticates as on every run after the first.
#
# Leave BLANK on a fresh deploy: provision-stalwart creates the account using
# STALWART_FALLBACK_ADMIN_SECRET above and keeps using that.
#
# Set it if you configured Stalwart through the web admin UI before running
# provision-stalwart — the wizard sets its own admin password, which is NOT the
# fallback secret, and provisioning cannot authenticate without it. Also set it
# here if you later change the admin password in the UI.
STALWART_ADMIN_PASSWORD=

# Postgres credentials for the Stalwart database.
# Generate: openssl rand -base64 24
STALWART_DB_NAME=stalwart
STALWART_DB_USER=stalwart
STALWART_DB_PASSWORD=
# Stalwart's OWN dedicated Redis instance (stalwart-redis/) — separate from
# the fediverse apps' shared Redis above, not a logical-DB index on it (see
# the Redis section above for why: HA and isolation both want a separate
# instance, not shared-DB namespacing). STALWART_REDIS_MAGIC_NAME is set in
# the MagicDNS section above.
# Generate: openssl rand -hex 32 (must be URL-safe — embedded in a redis:// URL)
STALWART_REDIS_PASSWORD=

# The stalwart-mail Garage bucket is created by 'bootstrap.sh provision-garage'
# (the bucket name is hardcoded there; changing this var has no effect).
# It is PRIVATE (not website-served) — mail blobs must not be publicly browseable.
# Garage credentials are STALWART_GARAGE_KEY_ID / STALWART_GARAGE_KEY_SECRET
# above — the only key granted the private mail bucket (SECURITY.md §5.7).
STALWART_S3_BUCKET=stalwart-mail

# Relay / catch-all account. All unmatched inbound mail is delivered here.
# Local part only (the domain is STALWART_DOMAIN above).
# Generate: openssl rand -base64 24
STALWART_RELAY_USER=postmaster
STALWART_RELAY_PASSWORD=

# Optional: smarthost relay for outbound delivery. Informational only — configure
# the actual route in the admin UI (Settings → Queues → Outbound). Leave blank
# for direct MX delivery. Use a Tailscale IP or MagicDNS name (never a dual-stack
# hostname — Stalwart tries AAAA first and won't fall back to A on ENETUNREACH).
STALWART_SMARTHOST=

# 'bootstrap.sh up stalwart' auto-runs 'provision-stalwart' which configures:
#   - Blob store → Garage S3 (stalwart-mail bucket)
#   - In-memory store → Redis (STALWART_REDIS_MAGIC_NAME — bring that stack
#     up FIRST: ./bootstrap.sh up stalwart-redis)
#   - Primary domain (STALWART_DOMAIN) with dual-algorithm DKIM + catch-all
#   - admin@STALWART_DOMAIN (persistent superuser, password = STALWART_FALLBACK_ADMIN_SECRET)
#   - STALWART_RELAY_USER@STALWART_DOMAIN (catch-all account)
#   - Mail listeners (25/465/587/143/993) with PROXY protocol trust for tailnet
#   - Prints DNS records to publish (MX, SPF, DKIM, DMARC, MTA-STS, etc.)
# Re-run any time (idempotent): ./bootstrap.sh provision-stalwart
#
# ACME (TLS certs): configure after provisioning in the admin UI:
#   http://STALWART_MAGIC_NAME.TS_TAILNET:8080 → Settings → TLS → ACME Providers
#   Use DNS-01 — wildcard certs require it. Stalwart manages and renews them.

# SSO via Authelia OIDC (opt-in). Requires the authelia stack to be up.
# The admin and relay accounts always retain password auth as break-glass.
STALWART_SSO_ENABLE=false
STALWART_OIDC_CLIENT_SECRET=

# L4 edge: the caddy edge lives in stalwart/caddy/ and is brought up
# separately (docker compose up -d --build) on the public reverse-proxy host.
# It requires STALWART_MAGIC_NAME, STALWART_DOMAIN, and TS_TAILNET from above.

# ---- High availability: second Stalwart node (optional) -------------------
# Single node by default: leave STALWART_CLUSTER_ENABLE=false and skip this
# block. Purpose is UPTIME for inbound mail across a whole-host outage — a
# second, independent mail server + its own public MX record — not backups.
# Full walkthrough: README "Stalwart high availability".
#
# Stalwart's clustering is unusually low-effort here because it's already
# stateless-by-design over shared backends: the data store (Postgres), blob
# store (Garage), and full-text index all already live in this stack's
# shared Postgres/Garage — which is why this is worth doing only AFTER
# Postgres HA (PG_ROLE above) and Garage HA/clustering are in place; a
# second Stalwart node is only as available as the Postgres+Garage it reads
# from. Stalwart's dedicated Redis (STALWART_REDIS_* above) can optionally
# get the same HA treatment too — see "High availability: Stalwart's Redis"
# below — but the coordinator itself degrades gracefully even without it;
# see the comment on STALWART_CLUSTER_ENABLE.
#
# Bring-up (two SEPARATE hosts, each with their OWN .env):
#   1. Node 2's .env: copy node 1's Stalwart section VERBATIM for the
#      SHARED-IDENTITY vars (STALWART_DOMAIN, STALWART_HOSTNAME, STALWART_
#      DB_*, STALWART_S3_BUCKET, STALWART_RELAY_*, STALWART_FALLBACK_ADMIN_
#      SECRET, the GARAGE_* / REDIS_* / DB_MAGIC_NAME / TS_TAILNET values
#      it reaches the shared backends through) — these all write to ONE
#      shared row set in Postgres, so a mismatch on node 2 silently
#      clobbers node 1's config (e.g. a different STALWART_DB_PASSWORD
#      changes the password node 1 also uses).
#   2. Node 2's .env: set its OWN STALWART_MAGIC_NAME (e.g. stalwart-2 —
#      THIS is the one value that MUST differ; it doubles as the node's
#      cluster identity — see the STALWART_HOSTNAME comment in stalwart/
#      docker-compose.yml). Set STALWART_CLUSTER_ENABLE=true on BOTH nodes.
#   3. ./bootstrap.sh up stalwart on node 2 — clones the SAME shared config
#      from Postgres (idempotent), starts, and (since CLUSTER_ENABLE=true)
#      wires the pub/sub coordinator.
#   4. Deploy stalwart/caddy/ on node 2's OWN public-facing box, with its
#      OWN .env's STALWART_MAGIC_NAME pointing at node 2. OMIT the "web"
#      :443 server block in caddy.json (MTA-STS/autoconfig/autodiscover
#      stay node-1-only — a documented, deliberate asymmetry, not a bug).
#      Get node 2 its OWN narrow ACME cert (its own hostname only, NOT a
#      wildcard — avoids any duplicate-issuance/rate-limit collision with
#      node 1's wildcard cert) via its own admin UI.
#   5. Add a SECOND MX record (higher priority number = lower preference)
#      pointing at node 2's edge. See README "Add DNS records".
#
# Toggle: enables the JMAP call that wires the cluster pub/sub coordinator
# (reuses the Redis connection already configured above — no new
# credentials). Harmless to enable on a lone single node; only meaningful
# once a second node exists.
STALWART_CLUSTER_ENABLE=false

# ---- High availability: Stalwart's Redis (optional) -----------------------
# Single instance by default: leave STALWART_REDIS_ROLE unset and skip this
# block. Purpose is UPTIME for the pieces that depend on Stalwart's Redis-
# backed in-memory store — rate limiting, fail2ban/blocked-IP counters,
# distributed locks, OAuth codes, ACME tokens, greylisting, and (if
# STALWART_CLUSTER_ENABLE=true above) the cluster coordinator pub/sub — NOT
# backups. A hot replica on a SECOND host, manual promotion (one command),
# and a repoint, mirroring the Postgres HA pattern above. Full walkthrough:
# README "Stalwart Redis high availability".
#
# Deliberately scoped to Stalwart ONLY, not the shared fediverse-apps Redis
# (REDIS_MAGIC_NAME) — see the Redis section above for why that one stays
# single-instance stack-wide. Also simpler than the Postgres pattern: Redis
# needs no separate replication role/slot or manual clone step — passing
# --replicaof at startup is enough, and STALWART_REDIS_PASSWORD doubles as
# the replication credential.
#
# This node's OWN Redis MagicDNS name. Single node: leave unset (defaults to
# "stalwart-redis" == STALWART_REDIS_MAGIC_NAME above). HA: set per-host
# (e.g. stalwart-redis-primary / stalwart-redis-standby).
# STALWART_REDIS_MAGIC_NAME then names the stalwart-redis-router sidecar
# Stalwart actually dials, NOT a specific node.
STALWART_REDIS_NODE_MAGIC_NAME=stalwart-redis
# Role of THIS host's Stalwart Redis: "primary" (default) or "standby".
STALWART_REDIS_ROLE=primary
# The CURRENT primary's node name. Used by the standby (replication source)
# and by stalwart-redis-router (where to send Stalwart's traffic). On
# failover: promote the standby, set this to the promoted node, and re-run
# 'up stalwart-redis-router'.
STALWART_REDIS_PRIMARY_MAGIC_NAME=stalwart-redis-primary


# ----------------------------------------------------------------------------
# PeerTube
# ----------------------------------------------------------------------------
# Public hostname (NO scheme, NO trailing slash).
# DO NOT change this after first boot — it is baked into account URIs.
PEERTUBE_DOMAIN=peertube.example.com

# Image tag. Pin a specific PeerTube version and bump deliberately —
# schema migrations run on start, so surprise upgrades can break things.
# See https://github.com/Chocobozzz/PeerTube/releases for current tags.
PEERTUBE_VERSION=v7.3.0-bookworm

# Initial admin email. The root user is created on first boot with a random
# password printed to the container logs; grep the logs to retrieve it:
#   docker compose -f peertube/docker-compose.yml logs peertube | grep -i 'password'
PEERTUBE_ADMIN_EMAIL=admin@peertube.example.com

# Session secret. Required.
# Generate: openssl rand -hex 32
PEERTUBE_SECRET=

# Per-app DB credentials. The initdb script also creates the pg_trgm,
# unaccent, and uuid-ossp extensions in this database (PeerTube needs all
# three). On an existing pg-data volume, see README "Troubleshooting" for
# the manual CREATE EXTENSION snippet.
# Generate: openssl rand -base64 24
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_USER=peertube
PEERTUBE_DB_PASSWORD=

# Email. Relay credentials come from the shared SMTP_* block above; only the
# sender address and TLS mode are per-app here. Without SMTP, confirmations fail.
PEERTUBE_SMTP_FROM=noreply@peertube.example.com
# TLS=false + STARTTLS is correct for port 587 (the shared default).
# For an implicit-TLS relay on port 465, set PEERTUBE_SMTP_TLS=true here.
PEERTUBE_SMTP_TLS=false

# ---- PeerTube object storage (S3 via Garage) — opt in --------------------
# Leave PEERTUBE_OBJECT_STORAGE_ENABLED=false to keep videos on the local
# peertube-data volume. Set to true to store web_videos and
# streaming_playlists in Garage (or any S3-compatible provider).
#
# ENDPOINT: defaults to the Garage MagicDNS name. But PeerTube — unlike every
# other app in this stack — has NO force-path-style option (upstream issue
# Chocobozzz/PeerTube#4455). Its AWS SDK uses VIRTUAL-HOST addressing and
# prepends the bucket as a subdomain (<bucket>.garage.<tailnet>), which MagicDNS
# cannot resolve, so the move-to-object-storage job fails with ENOTFOUND.
# Workaround: set the endpoint to Garage's Tailscale *IP* — the SDK can't put a
# bucket subdomain on a bare IP, so it falls back to path-style. Get the IP via:
#   tailscale status | grep garage
# Leave this unset only if your S3 provider genuinely supports virtual-host
# addressing (e.g. real AWS S3).
PEERTUBE_OBJECT_STORAGE_ENDPOINT=http://100.x.y.z:3900
#
# Credentials come from PEERTUBE_GARAGE_KEY_ID / PEERTUBE_GARAGE_KEY_SECRET
# above. Buckets (peertube-web-videos, peertube-streaming-playlists) are
# created by `bootstrap.sh provision-garage`.
#
# BASE_URL is what PeerTube emits in <video src=...>. Leave empty to use
# ENDPOINT/BUCKET — set explicitly when fronting the bucket with a CDN.
PEERTUBE_OBJECT_STORAGE_ENABLED=false
PEERTUBE_OBJECT_STORAGE_REGION=garage
PEERTUBE_OBJECT_STORAGE_UPLOAD_ACL_PUBLIC=public-read
PEERTUBE_OBJECT_STORAGE_UPLOAD_ACL_PRIVATE=private
# NOTE: credentials are NOT set here. peertube/docker-compose.yml maps
# PEERTUBE_GARAGE_KEY_ID / PEERTUBE_GARAGE_KEY_SECRET directly into the
# PEERTUBE_OBJECT_STORAGE_CREDENTIALS_* vars. To use a different S3 provider,
# edit the credential lines in peertube/docker-compose.yml.
# Bucket names match what `bootstrap.sh provision-garage` creates. BASE_URLs are
# public hosts that front each bucket's Garage web endpoint (:3902) via the
# reverse proxy — one subdomain per bucket (PeerTube uses two buckets). See
# nginx/sites-available/garage-media.conf for the Host-rewrite snippet.
PEERTUBE_OBJECT_STORAGE_WEB_VIDEOS_BUCKET=peertube-web-videos
PEERTUBE_OBJECT_STORAGE_WEB_VIDEOS_PREFIX=
PEERTUBE_OBJECT_STORAGE_WEB_VIDEOS_BASE_URL=https://video-peertube.example.com
PEERTUBE_OBJECT_STORAGE_STREAMING_PLAYLISTS_BUCKET=peertube-streaming-playlists
PEERTUBE_OBJECT_STORAGE_STREAMING_PLAYLISTS_PREFIX=
PEERTUBE_OBJECT_STORAGE_STREAMING_PLAYLISTS_BASE_URL=https://playlist-peertube.example.com

# ---- PeerTube OIDC SSO (Authelia) ----------------------------------------
# PeerTube has no env-based OIDC — login is delegated via the
# peertube-plugin-auth-openid-connect plugin, installed and configured in the
# admin UI AFTER first boot. Set ENABLED=true and a secret here; bootstrap.sh
# registers the matching Authelia client (redirect URI
# https://<PEERTUBE_DOMAIN>/plugins/auth-openid-connect/router/code-cb). Then in
# the plugin settings paste the client id/secret and the provider URL
# (https://<AUTHELIA_DOMAIN>). Generate the secret: openssl rand -hex 32
PEERTUBE_OIDC_ENABLED=false
PEERTUBE_OIDC_CLIENT_ID=peertube
PEERTUBE_OIDC_CLIENT_SECRET=


# ----------------------------------------------------------------------------
# Authelia — SSO / OIDC provider
# ----------------------------------------------------------------------------
# Pin and bump deliberately — check release notes before upgrading.
AUTHELIA_VERSION=4.39.20

# Public domain for the Authelia login portal (proxied by reverse proxy).
AUTHELIA_DOMAIN=auth.example.com

# Postgres credentials for Authelia's token/session database.
# Generate: openssl rand -base64 24
AUTHELIA_DB_NAME=authelia
AUTHELIA_DB_USER=authelia
AUTHELIA_DB_PASSWORD=

# Redis logical DB index on Authelia's DEDICATED instance (:6380 — see the
# Redis section above). The index is legacy-kept at 4; the instance is
# Authelia's alone, so the index no longer carries any isolation duty.
AUTHELIA_REDIS_DB=4

# Secret keys. All four MUST be generated before first boot.
# Generate each with: openssl rand -hex 64
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_OIDC_HMAC_SECRET=

# Email (from the shared SMTP relay above). Only the sender address is per-app.
AUTHELIA_MAIL_FROM=noreply@auth.example.com

# OIDC JWKS key — RSA private key used to sign ID tokens. Operator-generated,
# NOT committed to git (see .gitignore). Generate once:
#   openssl genrsa -out authelia/private.pem 4096
# The path authelia/private.pem is the expected location inside the container
# (see authelia/configuration.yml identity_providers.oidc.jwks).
# OIDC clients (GoToSocial, Mastodon, Funkwhale, PeerTube) are configured in
# authelia/configuration.yml — see the commented examples there.


# ----------------------------------------------------------------------------
# Lemmy
# ----------------------------------------------------------------------------
# Public hostname (NO scheme, NO trailing slash).
# DO NOT change this after first boot — it is baked into federation URIs
# and changing it breaks existing accounts, posts, and remote subscriptions.
LEMMY_DOMAIN=lemmy.example.com

# Image tag. Backend (dessalines/lemmy) and UI (dessalines/lemmy-ui) must
# be the SAME version — API mismatches produce runtime failures.
# See https://github.com/LemmyNet/lemmy/releases for available tags.
LEMMY_VERSION=0.19.5

# Per-app DB credentials.
# Generate: openssl rand -base64 24
LEMMY_DB_NAME=lemmy
LEMMY_DB_USER=lemmy
LEMMY_DB_PASSWORD=

# Pictrs API key — arbitrary shared secret between Lemmy and its image service.
# Must be set before first boot (left blank, pictrs rejects all uploads).
# Generate: openssl rand -hex 32
LEMMY_PICTRS_API_KEY=

# pict-rs image storage backend. Leave 'filesystem' to keep images on the local
# pictrs-data volume. Set 'object_storage' to store them in Garage S3 — a
# PRIVATE bucket, since Lemmy serves images THROUGH pict-rs (/pictrs/*), so no
# public media host / Caddy rewrite is needed (unlike the other media apps).
# Requires `provision-garage` (creates lemmy-pictrs) + LEMMY_GARAGE_KEY_*.
LEMMY_PICTRS_STORE=filesystem
LEMMY_PICTRS_S3_BUCKET=lemmy-pictrs

# SSO: not available — Lemmy's OAuth/OIDC is dev-branch only, absent from stable
# releases (0.19.x). There are intentionally no LEMMY_OIDC_* vars; the admin is
# created via Lemmy's first-web-visit setup wizard. Revisit when Lemmy ships OAuth.
