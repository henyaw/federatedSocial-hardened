# federated-social — host reverse proxy (Caddy)
# ----------------------------------------------------------------------------
# Caddy is the simplest path to public TLS on this stack — it auto-acquires
# Let's Encrypt certificates for every domain on first request and renews
# them on a timer. No certbot, no separate cron job.
#
# Quick path:
#   1. cp caddy/Caddyfile /etc/caddy/Caddyfile
#   2. Replace pixelfed.example.com / mastodon.example.com / etc. with your
#      real public domains (match your .env *_DOMAIN values).
#   3. Replace tailfe8c.ts.net with your TS_TAILNET value from .env.
#   4. Optional but recommended: replace admin@example.com with a real
#      address (Let's Encrypt sends expiry warnings there).
#   5. sudo systemctl reload caddy
#
# Prerequisites:
#   - A or AAAA records for each public domain pointing to this host.
#   - Inbound TCP/80 and TCP/443 open in your firewall.
#   - Host machine tagged tag:reverse-proxy in the Tailscale admin console
#     (Machines -> this host -> Edit tags). Required so the ACL grants in
#     acl.example.hujson allow it to reach the app web tiers over the
#     tailnet. Without this tag, you'll see 200s from nothing — the proxy
#     can't even open a TCP connection to the upstreams.
#
# WebSockets, Host header forwarding, HTTP/2, automatic redirect from :80
# to :443, X-Forwarded-* headers — Caddy's `reverse_proxy` directive
# handles all of these by default. Nothing to configure.

{
  email admin@example.com

  # This Caddy shares the host with the Stalwart L4 mail edge (layer4 block
  # below), which owns the public :443 for SNI fan-out. Move Caddy's own web
  # HTTPS to :8443 so the two don't collide. (Omit both this line and the
  # layer4 block if a dedicated edge box runs the mail edge instead.)
  https_port 8443

  # The :443 fan-out hands web connections to :8443 over 127.0.0.1, which would
  # otherwise hide the client IP — apps would see 127.0.0.1 in X-Forwarded-For
  # and break per-client rate limiting (GoToSocial warns about exactly this).
  # Accept PROXY protocol on the L7 listeners from the local edge so the real
  # client IP survives the hop. `allow 127.0.0.1/32` scopes it to the edge so
  # direct connections (e.g. :80 ACME challenges) pass through untouched; `tls`
  # re-applies TLS termination after the wrapper. Pair with `proxy_protocol v2`
  # on the :443 -> 127.0.0.1:8443 route below, and trust 100.64.0.0/10 in each
  # app (e.g. PIXELFED_TRUST_PROXIES, GOTOSOCIAL_PROXY).
  servers {
    listener_wrappers {
      proxy_protocol {
        allow 127.0.0.1/32
      }
      tls
    }
  }

  # ---------------------------------------------------------------------------
  # L4 mail edge — Stalwart TCP pass-through
  # ---------------------------------------------------------------------------
  # Remove or comment out this entire layer4 block if you are NOT using Caddy
  # as the mail port edge on this host (e.g. you have a dedicated edge box
  # running stalwart/caddy/docker-compose.yml instead).
  #
  # Replace stalwart.tailfe8c.ts.net with your STALWART_MAGIC_NAME.TS_TAILNET
  # value and mail.example.com with your STALWART_DOMAIN value.
  #
  # REQUIRES the custom Caddy binary with caddy-l4 module.
  # See caddy/README.md for download and installation instructions.

  layer4 {
    # ---- SMTP (plaintext + STARTTLS) ----
    :25 {
      route {
        proxy {
          proxy_protocol v2
          upstream stalwart.tailfe8c.ts.net:25
        }
      }
    }
    # ---- SMTPS (implicit TLS) ----
    :465 {
      route {
        proxy {
          proxy_protocol v2
          upstream stalwart.tailfe8c.ts.net:465
        }
      }
    }
    # ---- Submission (STARTTLS) ----
    :587 {
      route {
        proxy {
          proxy_protocol v2
          upstream stalwart.tailfe8c.ts.net:587
        }
      }
    }
    # ---- IMAP (plaintext + STARTTLS) ----
    :143 {
      route {
        proxy {
          proxy_protocol v2
          upstream stalwart.tailfe8c.ts.net:143
        }
      }
    }
    # ---- IMAPS (implicit TLS) ----
    :993 {
      route {
        proxy {
          proxy_protocol v2
          upstream stalwart.tailfe8c.ts.net:993
        }
      }
    }
    # ---- :443 SNI fan-out ----
    # Stalwart's web endpoints (MTA-STS policy, autoconfig, autodiscover)
    # present specific SNI names — route those to Stalwart, which terminates
    # TLS with its own wildcard cert (no PROXY protocol on this route).
    # All other SNI falls through to this Caddy's own HTTPS listener on :8443,
    # WITH PROXY protocol v2 so the client IP reaches the listener_wrappers
    # block in the global options above (https_port 8443 is set there).
    :443 {
      # Matcher lives at the segment level (not inside route) — caddy-l4 rejects
      # `proxy @name` inside a route block.
      @stalwart-sni tls sni mta-sts.mail.example.com autoconfig.mail.example.com autodiscover.mail.example.com
      route @stalwart-sni {
        proxy {
          upstream stalwart.tailfe8c.ts.net:443
        }
      }
      route {
        proxy {
          proxy_protocol v2
          upstream 127.0.0.1:8443
        }
      }
    }

    # ---- Garage S3 API HA load-balancer (OPTIONAL, multi-node only) ----
    # Fronts the S3 API (:3900) of every Garage cluster node so app -> S3
    # traffic fails over automatically instead of depending on one node.
    # Enable by uncommenting; then set GARAGE_S3_ENDPOINT_NAME in .env to
    # THIS host's MagicDNS name so apps target the LB. It is a plain TCP
    # (layer4) proxy — S3 SigV4 signs the Host header and path, so the bytes
    # must pass through unaltered; Garage validates the exact request the app
    # signed. Bind THIS host's Tailscale IP (`tailscale ip -4`) so :3900 is
    # never offered publicly. Requires ACL grants tag:reverse-proxy ->
    # tag:garage:3900 and <app tags> -> tag:reverse-proxy:3900 (both in
    # acl.example.hujson). nginx-stream equivalent: nginx/sites-available/garage-s3.conf.
    #
    # 100.x.y.z:3900 {
    #   route {
    #     proxy {
    #       upstream garage-1.tailfe8c.ts.net:3900
    #       upstream garage-2.tailfe8c.ts.net:3900
    #       upstream garage-3.tailfe8c.ts.net:3900
    #       lb_policy round_robin
    #       health_interval 10s
    #       health_timeout 3s
    #     }
    #   }
    # }
  }
}

# ---------------------------------------------------------------------------
# Pixelfed
# ---------------------------------------------------------------------------
# Pixelfed's container nginx listens on port 80 inside its sidecar netns,
# reachable via MagicDNS over the tailnet.
#
# Host header, X-Forwarded-* and request streaming are Caddy defaults and are
# what make TRUST_PROXIES=* inside the app behave (it sees https + real client
# IP). The directives below add what Caddy does NOT do by default:
#   - encode:        compress API/ActivityPub/HTML responses.
#   - HSTS:          Caddy auto-provisions TLS but adds no HSTS header.
#   - request_body:  Caddy has no default body limit; cap it so a public
#                    endpoint can't be flooded with an arbitrarily large POST.
#                    32MB is ~2x Pixelfed's default per-file MAX_PHOTO_SIZE
#                    (~15MB; the composer uploads one file per request). If you
#                    raise MAX_PHOTO_SIZE in .env, raise this to match.
pixelfed.example.com {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"
  request_body {
    max_size 32MB
  }
  reverse_proxy pixelfed.tailfe8c.ts.net:80
}

# ---------------------------------------------------------------------------
# Pixelfed media — ONLY when storing uploads in S3/Garage (PF_ENABLE_CLOUD=true)
# ---------------------------------------------------------------------------
# With cloud storage, Pixelfed builds media URLs from AWS_URL, so set
# PIXELFED_S3_URL=https://pixelfed-media.example.com in .env (it becomes the
# app's AWS_URL) and this block fronts Garage's web endpoint (:3902 — the app
# itself talks to the S3 API on :3900 via AWS_ENDPOINT). The header_up Host
# line is the whole point: object stores route by Host, so we send the *bucket
# vhost* (<AWS_BUCKET>.<garage-web-root-domain, set in garage.toml>), not the
# public hostname, so Garage serves the right bucket. This is GET-only public
# traffic — uploads go from the app to Garage over the tailnet, not through here.
pixelfed-media.example.com {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy http://garage.tailfe8c.ts.net:3902 {
    header_up Host pixelfed-media.web.garage.local
  }
}

# ---------------------------------------------------------------------------
# Mastodon — Rails web + Node streaming behind one public hostname
# ---------------------------------------------------------------------------
# /api/v1/streaming/* goes to the Node streaming server on :4000 (WebSocket
# upgrade is automatic in Caddy). Everything else goes to Puma on :3000.
mastodon.example.com {
  @streaming path /api/v1/streaming /api/v1/streaming/*
  handle @streaming {
    reverse_proxy mastodon-streaming.tailfe8c.ts.net:4000
  }
  handle {
    reverse_proxy mastodon.tailfe8c.ts.net:3000
  }
}

# Public media — ONLY when MASTODON_S3_ENABLED=true. Set in .env:
#   MASTODON_S3_ALIAS_HOST=mastodon-media.example.com   (host only, no scheme)
# Fronts Garage's WEB endpoint (:3902), NOT the S3 API (:3900, signed-only).
# header_up Host selects the bucket. See README "Serving media to the public".
mastodon-media.example.com {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy http://garage.tailfe8c.ts.net:3902 {
    header_up Host mastodon-media.web.garage.local
  }
}

# ---------------------------------------------------------------------------
# Diaspora
# ---------------------------------------------------------------------------
# Rails listens on :3000 inside the diaspora sidecar. The koehn image also
# runs lighttpd on :8080 for precompiled assets, but :3000 serves both fine
# for small/medium pods.
diaspora.example.com {
  reverse_proxy diaspora.tailfe8c.ts.net:3000
}

# ---------------------------------------------------------------------------
# Plume
# ---------------------------------------------------------------------------
# Rocket (Rust) on :7878 serves the whole app — federation, web UI, assets.
plume.example.com {
  reverse_proxy plume.tailfe8c.ts.net:7878
}

# ---------------------------------------------------------------------------
# Funkwhale
# ---------------------------------------------------------------------------
# The funkwhale `front` container (nginx serving the Vue SPA and proxying to
# the API on 127.0.0.1:5000 inside its shared netns) listens on :80. Audio
# uploads can be large; the front nginx is configured for 100M
# (NGINX_MAX_BODY_SIZE in funkwhale/docker-compose.yml). Match here.
funkwhale.example.com {
  request_body {
    max_size 100MB
  }
  reverse_proxy funkwhale.tailfe8c.ts.net:80
}

# ---------------------------------------------------------------------------
# GoToSocial
# ---------------------------------------------------------------------------
# GTS serves everything (web, API, federation, streaming WebSockets) on :8080.
# Caddy upgrades WebSockets transparently. Media-local-max-size defaults to
# 40 MiB; bump both here and gotosocial config if you raise it.
gotosocial.example.com {
  request_body {
    max_size 40MB
  }
  reverse_proxy gotosocial.tailfe8c.ts.net:8080
}

# Public media — ONLY when GOTOSOCIAL_STORAGE_BACKEND=s3 and GOTOSOCIAL_S3_PROXY=false.
# Set in .env: GOTOSOCIAL_S3_REDIRECT_URL=https://gts-media.example.com
# Fronts Garage's WEB endpoint (:3902), NOT the S3 API (:3900, signed-only).
# header_up Host selects the bucket. See README "Serving media to the public".
gts-media.example.com {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy http://garage.tailfe8c.ts.net:3902 {
    header_up Host gotosocial-media.web.garage.local
  }
}

# ---------------------------------------------------------------------------
# PeerTube (HTTP/HTTPS)
# ---------------------------------------------------------------------------
# PeerTube serves the web UI, API, federation, and live-streaming WebSocket
# (/socket.io) on :9000. Caddy upgrades WebSockets automatically.
#
# Uploads are large by design — raise max_size to a comfortable ceiling for
# your instance. The long write/read timeouts are for slow uploads on
# residential connections.
#
# NOTE: RTMP live ingest is a separate concern. Caddy does not proxy raw TCP
# (no equivalent to nginx's stream module). If you need PUBLIC RTMP ingest,
# either:
#   - have streamers publish directly to the tailnet hostname
#     (rtmp://peertube.tailfe8c.ts.net:1935 — most secure, no public
#     exposure), or
#   - run nginx alongside Caddy for just the stream {} block — see
#     nginx/sites-available/peertube-rtmp.conf for the reference snippet.
peertube.example.com {
  request_body {
    max_size 8GB
  }
  reverse_proxy peertube.tailfe8c.ts.net:9000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
      dial_timeout 30s
    }
    flush_interval -1
  }
}

# Public media — ONLY when PEERTUBE_OBJECT_STORAGE_ENABLED=true.
# PeerTube is the one app that needs TWO media hosts: it stores web videos and
# HLS streaming playlists in SEPARATE buckets, and each media domain maps to
# exactly one bucket. Set both in .env:
#   PEERTUBE_OBJECT_STORAGE_WEB_VIDEOS_BASE_URL=https://video-peertube.example.com
#   PEERTUBE_OBJECT_STORAGE_STREAMING_PLAYLISTS_BASE_URL=https://playlist-peertube.example.com
# Both front Garage's WEB endpoint (:3902); header_up Host selects the bucket.
# CORS (HLS playback fetches manifests + fmp4 segments cross-origin via MSE) is
# set on the buckets by provision-garage (S3 PutBucketCors), NOT here — this
# proxy just must not strip it. See README "Serving media to the public".
video-peertube.example.com {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy http://garage.tailfe8c.ts.net:3902 {
    header_up Host peertube-web-videos.web.garage.local
  }
}

playlist-peertube.example.com {
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy http://garage.tailfe8c.ts.net:3902 {
    header_up Host peertube-streaming-playlists.web.garage.local
  }
}

# ---------------------------------------------------------------------------
# Lemmy
# ---------------------------------------------------------------------------
# Lemmy's stack runs an internal nginx (the `proxy` container) that fans out
# to the backend (:8536), the SSR UI (:1234), and pict-rs (:8080) — all on
# localhost inside the shared sidecar netns. That internal nginx listens on
# :80, so the host proxy only needs to reach :80. WebSocket upgrades for live
# updates are handled by Caddy automatically.
#
# max_size matches client_max_body_size in lemmy/nginx.conf (the upstream
# Lemmy nginx default) — raise both together, plus pict-rs's
# PICTRS__MEDIA__MAX_FILE_SIZE, for larger uploads.
lemmy.example.com {
  request_body {
    max_size 20MB
  }
  reverse_proxy lemmy.tailfe8c.ts.net:80
}

# ---------------------------------------------------------------------------
# Authelia — SSO / OIDC login portal
# ---------------------------------------------------------------------------
# Authelia listens on :9091 inside its sidecar. All OIDC flows from GTS,
# Mastodon, Funkwhale, and PeerTube redirect the browser here for login.
auth.example.com {
  reverse_proxy authelia.tailfe8c.ts.net:9091
}

# ---------------------------------------------------------------------------
# Stalwart — JMAP API and admin web panel
# ---------------------------------------------------------------------------
# Stalwart's JMAP/admin HTTP server listens on :8080 inside its sidecar.
#
# IMPORTANT — :443 collision: if this Caddy host is ALSO running the
# Stalwart L4 edge (stalwart/caddy/), that process owns the public :443
# listener for SNI fan-out (MTA-STS/autoconfig/autodiscover pass-through).
# Caddy cannot bind :443 at the same time. Move this Caddy's HTTPS listener
# off :443 by adding to the global options block above:
#
#     {
#       email admin@example.com
#       https_port 8443           # <-- add this
#     }
#
# The L4 edge's catch-all SNI route forwards unmatched :443 traffic to
# 127.0.0.1:8443, so these blocks continue to work on a shared host.
# A dedicated reverse-proxy host (separate from the mailbox) needs no change.
mail.example.com {
  reverse_proxy stalwart.tailfe8c.ts.net:8080
}
